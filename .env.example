EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=sonet://auth/callback

EXPO_PUBLIC_TICKETMASTER_API_KEY=your-ticketmaster-key
EXPO_PUBLIC_YOUTUBE_API_KEY=your-youtube-data-api-key
EXPO_PUBLIC_ML_API_URL=http://localhost:8000

# Extra music metadata sources — all optional, each client no-ops if unset.
# MusicBrainz needs no key, just an identifiable User-Agent (already set in lib/musicbrainz.ts).
EXPO_PUBLIC_DISCOGS_TOKEN=your-discogs-personal-access-token
EXPO_PUBLIC_LASTFM_API_KEY=your-lastfm-api-key

# Extra concert sources — all optional, merged with Ticketmaster in lib/concerts.ts.
# Songkick requires partner approval (apply at songkick.com/api_key_requests/new).
EXPO_PUBLIC_SONGKICK_API_KEY=your-songkick-api-key
EXPO_PUBLIC_BANDSINTOWN_APP_ID=your-app-name
EXPO_PUBLIC_SEATGEEK_CLIENT_ID=your-seatgeek-client-id

# RevenueCat — gates event creation behind the Premium paywall.
# Get this from the RevenueCat dashboard (Project Settings → API Keys → Public app-specific key).
EXPO_PUBLIC_REVENUECAT_API_KEY=your-revenuecat-public-sdk-key

# Sentry — crash reporting. Get this from your Sentry project's Client Keys (DSN) settings.
# Without it, the app just doesn't report crashes anywhere — it won't break.
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn

# PostHog — product analytics. Get this from Project Settings → API Keys.
# Without it, tracking calls are just no-ops — nothing breaks, you just fly blind.
EXPO_PUBLIC_POSTHOG_API_KEY=your-posthog-project-api-key

# Backend .env (backend/.env — never commit)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
TICKETMASTER_API_KEY=your-ticketmaster-key
YOUTUBE_API_KEY=your-youtube-data-api-key
